# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=django-insecure-tersuite-studio-dev-key-change-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgresql://tersuite:tersuite_pass@localhost:5432/tersuite_db

# Test Database Configuration
TEST_DATABASE_URL=postgresql://tersuite:tersuite_pass@localhost:5432/tersuite_test_db

# Redis & Channels Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenHands Agent Server Integration
OPENHANDS_SERVER_URL=http://localhost:8000
OPENHANDS_API_KEY=
OPENHANDS_TIMEOUT_SECONDS=120
OPENHANDS_DEFAULT_MODEL=anthropic/claude-sonnet-4-5-20250929

# Structured Logging
LOG_LEVEL=INFO
